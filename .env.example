# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Chat provider ---------------------------------------------------------
# anthropic | openai
CHAT_PROVIDER=anthropic
# Defaults: claude-opus-5 (anthropic), gpt-4.1-mini (openai)
CHAT_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Point at any OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, a gateway)
# to keep document text inside your own infrastructure. Leave blank for OpenAI.
# OPENAI_BASE_URL=http://localhost:11434/v1

# Reasoning depth for Anthropic models: low | medium | high | xhigh | max
EFFORT=medium
MAX_OUTPUT_TOKENS=4000

# --- Embeddings ------------------------------------------------------------
# openai  -> hosted, needs OPENAI_API_KEY
# local   -> on-device sentence-transformers (pip install -r requirements-local.txt)
# none    -> keyword-only (BM25) retrieval, no embedding cost at all
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ----------------------------------------------------------
# memory   -> in-process NumPy index with an on-disk cache (single instance)
# postgres -> pgvector, persistent and shared across replicas
VECTOR_STORE=memory

# Database password, used by docker compose to provision Postgres AND by the
# app to connect. There is deliberately no default -- compose refuses to start
# without it. Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_USER=pdfchat
POSTGRES_DB=pdfchat

# Only set DATABASE_URL when connecting to a database compose does not manage.
# Under docker compose it is built from the values above automatically.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
PG_TABLE=pdfchat_chunks
PG_POOL_SIZE=8
# IVFFlat list count; a good starting point is sqrt(expected chunk count).
PG_IVFFLAT_LISTS=100
PERSIST_CONVERSATIONS=true

# --- Access control --------------------------------------------------------
# Generate with: python -m pdfchat.cli hash-password
# Leave empty to disable the login gate (localhost only!).
APP_PASSWORD_HASH=
# Minutes before a signed-in session must re-authenticate. 0 disables expiry.
SESSION_TTL_MINUTES=720
RATE_LIMIT_QUESTIONS_PER_HOUR=120

# --- Retrieval tuning ------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6
CANDIDATE_K=30
# 0.0 = pure keyword, 1.0 = pure semantic
HYBRID_DENSE_WEIGHT=0.5
# 1.0 = pure relevance, lower = more diverse passages
MMR_LAMBDA=0.6

# --- Reranking (precision stage) -------------------------------------------
# none          -> off (default; see docs, the shipped eval does not yet justify it)
# cross-encoder -> local model, no API cost (pip install -r requirements-local.txt)
# llm           -> scores passages with your chat model; costs a call per query
RERANKER=none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Candidates handed to the reranker. Must be >= TOP_K.
RERANK_CANDIDATES=20

# --- Behaviour -------------------------------------------------------------
ENABLE_SELF_CHECK=true
ENABLE_STREAMING=true
# Shows a small "Buy me a coffee" link in the sidebar footer. Set to false if
# you are hosting this for other people and would rather not display it.
SHOW_SUPPORT_LINK=true
MAX_UPLOAD_MB=50
MAX_PAGES_PER_DOC=2000
CACHE_DIR=.pdfchat_cache
LOG_LEVEL=INFO

# Override cost estimates: "model:INPUT/OUTPUT" in USD per 1M tokens.
# PDFCHAT_PRICE_OVERRIDES=my-model:1.5/7.5
