{
  "name": "PDF Study Assistant",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app.py"]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt && echo '✅ Dependencies installed — copy .env.example to .env and add your API key'",
  "postAttachCommand": {
    "server": "streamlit run app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "PDF Study Assistant",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}
